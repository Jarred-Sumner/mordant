// run-rustfix
// rustfix-only-machine-applicable
// One case per function. Each comment says the shape and whether `cargo dylint --fix`
// rewrites it, with the reason. "The part" is the run of statements the lint would move
// into a separate non-generic function. The test sets
// `generic-body-not-generic-min-statements = 16` so that these short bodies are reported.

pub trait Tag {
    fn seed(&self, salt: u32) -> u32;
    fn close(&self, word: u32) -> u32;
}

pub struct A;
pub struct B;

impl Tag for A {
    fn seed(&self, salt: u32) -> u32 {
        salt ^ 1
    }
    fn close(&self, word: u32) -> u32 {
        word ^ 1
    }
}

impl Tag for B {
    fn seed(&self, salt: u32) -> u32 {
        salt.wrapping_add(2)
    }
    fn close(&self, word: u32) -> u32 {
        word.wrapping_add(2)
    }
}

// Fixed: the part reads `src: &[u8]`, a reference, and `salt: u32`, and it ends with the
// body's final expression, so the call becomes the final expression.
pub fn checksum<T: Tag>(tag: &T, src: &[u8]) -> u32 {
    let salt = tag.seed(7);
    checksum_shared(src, salt)
}

fn checksum_shared(src: &[u8], salt: u32) -> u32 {
    let mut acc = (src.len() as u32) ^ salt;
    let mut i = 0usize;
    while i < src.len() {
        acc = acc.wrapping_mul(31).wrapping_add(u32::from(src[i]));
        acc ^= acc >> 5;
        i += 1;
    }
    (acc ^ (src.len() as u32)).rotate_left(7)
}

pub struct Packet<T> {
    pub payload: T,
    pub header: [u8; 4],
    pub declared_len: u32,
}

impl<T> Packet<T> {
    // Fixed: the part reads `header: [u8; 4]` and `declared: u32`, copied out of `self`
    // before it, and produces `checked: u32`. The new function goes after the `impl` block.
    pub fn header_word(&self) -> u32 {
        let header = self.header;
        let declared = self.declared_len.swap_bytes();
        let checked = header_word_shared(header, declared);
        checked ^ self.declared_len
    }
}

fn header_word_shared(header: [u8; 4], declared: u32) -> u32 {
    let mut word = 0u32;
    let mut shift = 0u32;
    let mut i = 0usize;
    while i < 4 {
        word |= u32::from(header[i]) << shift;
        shift += 8;
        i += 1;
    }
    let checked = (word ^ declared).rotate_left(declared & 31);
    checked
}

// Fixed: the part produces `lo: u32` and `hi: u32`, both read after it, so the call binds a
// pair.
pub fn split_sum<T: Tag>(tag: T, len: usize) -> u32 {
    let seed = tag.seed(9);
    let (lo, hi) = split_sum_shared(len, seed);
    tag.close(lo) ^ tag.close(hi)
}

fn split_sum_shared(len: usize, seed: u32) -> (u32, u32) {
    let mut a = len as u32 ^ seed;
    let mut b = !a;
    let mut i = 0usize;
    while i < len {
        a = a.wrapping_add(i as u32).rotate_left(3);
        b ^= a >> 2;
        i += 1;
    }
    let lo = (a & 0xffff).rotate_left(1);
    let hi = (b >> 16).wrapping_add(3);
    (lo, hi)
}

// Fixed: the part is in the middle of the body, after one use of `tag` and before another,
// and produces `total: u32`, which the statement after it reads.
pub fn emit<T: Tag>(tag: &T, len: usize, out: &mut u32) {
    let seed = tag.seed(13);
    let total = emit_shared(len, seed);
    *out = tag.close(total);
}

fn emit_shared(len: usize, seed: u32) -> u32 {
    let mut acc = len as u32 ^ seed;
    let mut i = 0usize;
    while i < len {
        acc = acc.rotate_left(7).wrapping_add(i as u32);
        acc ^= acc >> 5;
        i += 1;
    }
    let total = (acc ^ len as u32).wrapping_mul(3);
    total
}

pub struct Cursor {
    pub data: [u8; 8],
    pub pos: usize,
    pub sum: u32,
}

// Fixed: the part reads `cur: &mut Cursor`, a reference to a type of this crate, and writes
// through it, then produces `total: u32`. The new function names the type from the crate root.
pub fn advance<T: Tag>(tag: &T, cur: &mut Cursor, want: usize) -> u32 {
    let salt = tag.seed(3);
    let total = advance_shared(cur, want, salt);
    tag.close(total)
}

fn advance_shared(cur: &mut crate::Cursor, want: usize, salt: u32) -> u32 {
    let start = cur.pos.min(8);
    let end = start.saturating_add(want).min(8);
    let mut acc = cur.sum ^ salt;
    let mut i = start;
    while i < end {
        acc = acc.rotate_left(5) ^ u32::from(cur.data[i]);
        i += 1;
    }
    cur.pos = end;
    cur.sum = acc;
    let total = acc.wrapping_mul(31);
    total
}

// Fixed: `spread` is a `const fn`, so the new function is a `const fn` too.
pub const fn spread<T>(items: &[T], seed: u32) -> u32 {
    let n = items.len();
    spread_shared(seed, n)
}

const fn spread_shared(seed: u32, n: usize) -> u32 {
    let mut acc = seed ^ (n as u32);
    let mut i = 0usize;
    while i < n {
        acc = acc.rotate_left(5).wrapping_add(i as u32);
        acc ^= acc >> 3;
        i += 1;
    }
    (acc ^ (n as u32)).wrapping_mul(31)
}

pub struct Frame {
    pub len: u32,
    pub kind: u8,
}

impl Frame {
    // Reported, not fixed: the part reads `self`, which a free function cannot take.
    pub fn stamp<T: Tag>(&self, tag: &T) -> u32 {
        let salt = tag.seed(3);
        let mut acc = self.len ^ salt;
        let mut i = 0u32;
        while i < 8 {
            acc = acc.rotate_left(u32::from(self.kind)).wrapping_add(i);
            acc ^= acc >> 3;
            i += 1;
        }
        let total = (acc ^ self.len).wrapping_mul(31);
        tag.close(total)
    }
}

// Reported, not fixed: the first statement of the part also calls `seed`, so the part starts
// inside that statement and reads a value with no name.
pub fn mid_statement<T: Tag>(tag: T, len: usize) -> u32 {
    let mut acc = tag.seed(13) ^ len as u32;
    let mut i = 0usize;
    while i < len {
        acc = acc.rotate_left(7).wrapping_add(i as u32);
        acc ^= acc >> 3;
        i += 1;
    }
    let total = (acc ^ len as u32).wrapping_mul(37);
    tag.close(total)
}

// Reported, not fixed: `raw_sum` is an `unsafe fn`, and the part could hold operations that a
// safe function does not allow.
pub unsafe fn raw_sum<T: Tag>(tag: &T, len: usize) -> u32 {
    let seed = tag.seed(17);
    let mut acc = len as u32 ^ seed;
    let mut i = 0usize;
    while i < len {
        acc = acc.rotate_left(5).wrapping_add(i as u32);
        acc ^= acc >> 3;
        i += 1;
    }
    let total = (acc ^ len as u32).wrapping_mul(41);
    tag.close(total)
}

// Reported, not fixed: `gated` has a `cfg` attribute, which the new function would not get.
#[cfg(not(test))]
pub fn gated<T: Tag>(tag: &T, len: usize) -> u32 {
    let seed = tag.seed(19);
    let mut acc = len as u32 ^ seed;
    let mut i = 0usize;
    while i < len {
        acc = acc.rotate_left(5).wrapping_add(i as u32);
        acc ^= acc >> 3;
        i += 1;
    }
    let total = (acc ^ len as u32).wrapping_mul(43);
    tag.close(total)
}

// Reported, not fixed: the body declares an item, `STEP`, which the part could name and the
// new function could not.
pub fn stepped<T: Tag>(tag: &T, len: usize) -> u32 {
    const STEP: u32 = 7;
    let seed = tag.seed(23);
    let mut acc = len as u32 ^ seed;
    let mut i = 0usize;
    while i < len {
        acc = acc.rotate_left(STEP).wrapping_add(i as u32);
        acc ^= acc >> 3;
        i += 1;
    }
    let total = (acc ^ len as u32).wrapping_mul(STEP);
    tag.close(total)
}

fn step(acc: u32) -> Result<u32, u32> {
    if acc == 0 { Err(1) } else { Ok(acc.rotate_left(3)) }
}

// Reported, not fixed: the part contains `?`, which can return early.
pub fn try_sum<T: Tag>(tag: &T, len: usize) -> Result<u32, u32> {
    let seed = tag.seed(11);
    let mut acc = seed | 1;
    let mut i = 0usize;
    while i < len {
        acc = step(acc ^ i as u32)?;
        acc = acc.wrapping_add(3);
        i += 1;
    }
    Ok(acc.wrapping_add(len as u32))
}

fn main() {
    let _ = checksum(&A, b"abc") ^ checksum(&B, &[1, 2, 3]);
    let small = Packet { payload: 1u8, header: [1, 2, 3, 4], declared_len: 4 };
    let wide = Packet { payload: 1u64, header: [4, 3, 2, 1], declared_len: 8 };
    let _ = small.header_word() ^ wide.header_word();
    let _ = split_sum(A, 4) ^ split_sum(B, 6);
    let mut word = 0u32;
    emit(&A, 2, &mut word);
    emit(&B, 3, &mut word);
    let mut cur = Cursor { data: [1, 2, 3, 4, 5, 6, 7, 8], pos: 2, sum: 0 };
    let _ = advance(&A, &mut cur, 3) ^ advance(&B, &mut cur, 9);
    let _ = spread(&[1u8, 2, 3], 5) ^ spread(&["a", "b"], 7);
    let frame = Frame { len: 12, kind: 3 };
    let _ = frame.stamp(&A) ^ frame.stamp(&B);
    let _ = mid_statement(A, 2) ^ mid_statement(B, 3);
    let _ = unsafe { raw_sum(&A, 3) ^ raw_sum(&B, 2) };
    let _ = gated(&A, 4) ^ gated(&B, 5);
    let _ = stepped(&A, 6) ^ stepped(&B, 7);
    if let (Ok(a), Ok(b)) = (try_sum(&A, 3), try_sum(&B, 2)) {
        let _ = a ^ b;
    }
}
